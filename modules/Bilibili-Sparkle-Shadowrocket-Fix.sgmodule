#!name=哔哩哔哩增强（Shadowrocket 适配版）
#!desc=基于 kokoryh/Sparkle 的 Shadowrocket 适配版，适用于 B站 iOS 9.17+：去开屏/暂停/信息流广告、精简界面、评论区优化，空降助手在进度条显示「广告」章节（需手动点击跳过）。请勿与其他 B站模块同时启用。
#!category=Enhancement
#!author=misakayyds（适配）, kokoryh（Sparkle 原作者）
#!homepage=https://github.com/misakayyds/shadowrocket-modules
#!version=11.0.0

# 版本：V11（2026-11-01），测试环境 iOS 27.2 + 哔哩哔哩 9.17.0（91700100）
# 上游：https://github.com/kokoryh/Sparkle（GPL-3.0，官方不支持 Shadowrocket，本模块为第三方适配）
#
# 相对上游的主要改动：
# 1. 空降助手：上游在请求阶段重新发起 gRPC 请求并伪造响应，在小火箭上跑不通。这里改为
#    请求阶段记录 aid/cid（bilibili-viewprogress-capture.js），响应阶段查询 SponsorBlock（bsbsb.top）
#    并把「广告」章节写进 ViewProgress 的真实响应（bilibili-airborne-sr.js）。章节时间统一取整，
#    避免小火箭 BigInt 解析小数报错。9.17 起无法自动跳过，只能手动点击章节。
# 2. 开屏广告：小火箭的 Map Local 会被当成 REJECT（404），客户端随即回退到缓存广告，
#    所以改用响应脚本返回完整空结构，并清理 peak/download 里的 brand_splash（bilibili-splash-sr.js）。
# 3. 暂停广告：PlayPause / TFInfo / ViewEndPage 在响应阶段替换为空 gRPC 消息（bilibili-grpc-empty.js）。
# 4. 拒绝 B站 API 的 UDP/443（QUIC）并删除 Alt-Svc，确保请求走 HTTPS 才能被解密改写。

[Rule]
AND,((DOMAIN,grpc.biliapi.net),(PROTOCOL,UDP),(DST-PORT,443)),REJECT-NO-DROP,pre-matching
AND,((DOMAIN,app.bilibili.com),(PROTOCOL,UDP),(DST-PORT,443)),REJECT-NO-DROP,pre-matching
AND,((DOMAIN,api.bilibili.com),(PROTOCOL,UDP),(DST-PORT,443)),REJECT-NO-DROP,pre-matching
AND,((DOMAIN,api.live.bilibili.com),(PROTOCOL,UDP),(DST-PORT,443)),REJECT-NO-DROP,pre-matching

DOMAIN,cm.bilibili.com,REJECT,pre-matching,extended-matching
DOMAIN-SUFFIX,miaozhen.com,REJECT,pre-matching,extended-matching

DOMAIN,bsbsb.top,DIRECT

DOMAIN,api.biliapi.com,REJECT,pre-matching,extended-matching
DOMAIN,app.biliapi.com,REJECT,pre-matching,extended-matching
DOMAIN,api.biliapi.net,REJECT,pre-matching,extended-matching
DOMAIN,app.biliapi.net,REJECT,pre-matching,extended-matching
AND,((DOMAIN-SUFFIX,chat.bilibili.com), (OR,((DOMAIN-KEYWORD,stun), (DOMAIN-KEYWORD,tracker), (DOMAIN-KEYWORD,p2p)))),REJECT,pre-matching
DST-PORT,4480,REJECT-NO-DROP,pre-matching
DST-PORT,4483,REJECT-NO-DROP,pre-matching
DST-PORT,9102,REJECT-NO-DROP,pre-matching

[URL Rewrite]
^https?:\/\/upos-sz-static\.bilivideo\.com\/ssaxcode\/[^?]*-1-SPLASH(?:\.mp4)?(?:\?|$) - reject
^http:\/\/(?:[0-9]{1,3}\.){3}[0-9]{1,3}:8000\/v1\/resource\/[0-9A-Za-z]{32}-1-SPLASH(?:\?|$) - reject
^https:\/\/api\.bilibili\.com\/x\/mengqi\/v1\/resource(?:\?|$) - reject-dict
^https:\/\/api\.live\.bilibili\.com\/xlive\/e-commerce-interface\/v1\/ecommerce-user\/get_shopping_info(?:\?|$) - reject-dict
^https:\/\/line3-h5-mobile-api\.biligame\.com\/game\/live\/large_card_material(?:\?|$) - reject-dict
^https:\/\/ap[ip]\.bilibili\.com\/x\/(?:resource\/(?:top\/activity|patch\/tab(?:\/v2)?)|v2\/search\/square|vip\/ads\/materials)(?:\?|$) - reject-dict
^https:\/\/api\.bilibili\.com\/pgc\/activity\/deliver\/material\/receive(?:\?|$) - reject-dict
^https:\/\/(?:grpc\.biliapi\.net|app\.bilibili\.com)(?::443)?\/bilibili\.app\.interface\.v1\.Search\/DefaultWords$ - reject-dict

[Header Rewrite]
http-response ^https:\/\/(?:app\.bilibili\.com|api\.bilibili\.com|api\.live\.bilibili\.com|grpc\.biliapi\.net)(?::443)?\/ header-del Alt-Svc

[Body Rewrite]
http-response-jq ^https:\/\/app\.bilibili\.com(?::443)?\/x\/resource\/peak\/download(?:\?|$) 'if type == "object" then if .code == 0 and (.data | type) == "object" then if (.data.resource | type) == "array" then .data.resource |= map(if type == "object" then if ((.type == "brand_splash") or ((.type | type) == "string" and (.type | test("splash";"i")))) and (.list | type) == "array" then .list = [] else . end else . end) else . end else . end else . end'
http-response-jq ^https:\/\/api\.live\.bilibili\.com(?::443)?\/xlive\/open-interface\/v2\/tracker\/conf(?:\?|$) '.data.domains=["wss://tracker.chat.bilibili.com"]'
http-response-jq ^https:\/\/api\.bilibili\.com(?::443)?\/x\/pd-proxy\/tracker(?:\?|$) '.data[][]?="stun.chat.bilibili.com:3478"'
http-response-jq ^https:\/\/api\.bilibili\.com(?::443)?\/pgc\/view\/v2\/app\/season(?:\?|$) 'del(.data.payment)'
http-response-jq ^https:\/\/api\.bilibili\.com(?::443)?\/pgc\/page\/channel(?:\?|$) '.data.modules |= map(select(.type != "TIP") | if .type == "BANNER" then .module_data.items |= map(select(.url | startswith("https://www.bilibili.com/blackboard/era/") | not)) else . end)'

[Script]
# —— 开屏 + peak：本地 bilibili-splash-sr.js（长间隔 + list:[{}] + 清 brand_splash）——
bilibili.splash = type=http-response,pattern=^https:\/\/app\.bilibili\.com(?::443)?\/x\/v2\/splash\/(?:brand\/list|event\/list2?|list|show)(?:\?|$),requires-body=1,max-size=-1,engine=webview,timeout=10,script-path=https://raw.githubusercontent.com/misakayyds/shadowrocket-modules/main/scripts/bilibili-splash-sr.js
bilibili.peak = type=http-response,pattern=^https:\/\/app\.bilibili\.com(?::443)?\/x\/resource\/peak\/download(?:\?|$),requires-body=1,max-size=-1,engine=webview,timeout=10,script-path=https://raw.githubusercontent.com/misakayyds/shadowrocket-modules/main/scripts/bilibili-splash-sr.js

# —— 暂停广告 PlayPause / TFInfo / ViewEndPage：响应阶段替换为空 gRPC 消息（grpc 与 app 两个主机）——
bilibili.playpause = type=http-response,pattern=^https:\/\/(?:grpc\.biliapi\.net|app\.bilibili\.com)(?::443)?\/bilibili\.app\.(?:view\.v1\.View\/TFInfo|viewunite\.v1\.View\/(?:PlayPause|ViewEndPage))$,requires-body=1,binary-body-mode=1,max-size=-1,timeout=5,script-path=https://raw.githubusercontent.com/misakayyds/shadowrocket-modules/main/scripts/bilibili-grpc-empty.js

# —— 空降助手（9.17+）：请求阶段记录 aid/cid，响应阶段注入「广告」章节 ——
bilibili.vp.capture = type=http-request,pattern=^https:\/\/(?:grpc\.biliapi\.net|app\.bilibili\.com)(?::443)?\/bilibili\.app\.view(?:unite)?\.v1\.View\/ViewProgress$,requires-body=1,binary-body-mode=1,max-size=-1,timeout=5,script-path=https://raw.githubusercontent.com/misakayyds/shadowrocket-modules/main/scripts/bilibili-viewprogress-capture.js
bilibili.airborne = type=http-response,pattern=^https:\/\/(?:grpc\.biliapi\.net|app\.bilibili\.com)(?::443)?\/bilibili\.app\.view(?:unite)?\.v1\.View\/ViewProgress$,argument="{"logLevel":"4","sponsorBlock":true}",requires-body=1,binary-body-mode=1,max-size=-1,engine=webview,timeout=15,script-path=https://raw.githubusercontent.com/misakayyds/shadowrocket-modules/main/scripts/bilibili-airborne-sr.js

# 旧版弹幕空降（<9.17）仍可用；9.17+ 脚本内会 abort 该路径
bilibili.airborne.dm = type=http-request,pattern=^https:\/\/(?:grpc\.biliapi\.net|app\.bilibili\.com)(?::443)?\/bilibili\.community\.service\.dm\.v1\.DM\/DmSegMobile$,argument="{"logLevel":"4","sponsorBlock":true}",requires-body=1,binary-body-mode=1,max-size=-1,engine=webview,timeout=10,script-path=https://raw.githubusercontent.com/misakayyds/shadowrocket-modules/main/scripts/bilibili-airborne-sr.js

bilibili.protobuf.request = type=http-request,pattern=^https:\/\/(?:grpc\.biliapi\.net|app\.bilibili\.com)(?::443)?\/bilibili\.(?:app\.viewunite\.v1\.View\/View|main\.community\.reply\.v1\.Reply\/MainList)$,argument="{"purifyComment":1,"logLevel":"4"}",requires-body=1,binary-body-mode=1,max-size=-1,engine=webview,timeout=10,script-path=https://raw.githubusercontent.com/kokoryh/Sparkle/refs/heads/master/dist/bilibili.protobuf.request.js

bilibili.skin = type=http-response,pattern=^https:\/\/app\.bilibili\.com(?::443)?\/x\/resource\/show\/skin(?:\?|$),requires-body=1,max-size=-1,engine=webview,script-path=https://raw.githubusercontent.com/kokoryh/Script/master/js/bili-suit-diy.js

bilibili.live = type=http-response,pattern=^https:\/\/api\.live\.bilibili\.com(?::443)?\/xlive\/(?:app-interface\/v2\/index\/feed|app-room\/v1\/index\/getInfoBy(?:Room|User))(?:\?|$),requires-body=1,max-size=-1,engine=webview,script-path=https://raw.githubusercontent.com/kokoryh/Sparkle/refs/heads/master/dist/bilibili.json.js

bilibili.json = type=http-response,pattern=^https:\/\/app\.bilibili\.com(?::443)?\/x\/(?:resource\/show\/tab\/v2|v2\/(?:feed\/index(?:\/story)?|account\/(?:mine(?:\/ipad)?|myinfo)))(?:\?|$),argument="{"showCreatorHub":0}",requires-body=1,max-size=-1,engine=webview,script-path=https://raw.githubusercontent.com/kokoryh/Sparkle/refs/heads/master/dist/bilibili.json.js

bilibili.webpage = type=http-response,pattern=^https:\/\/www\.bilibili\.com(?::443)?\/blackboard\/era\/.+\.html(?:\?|$),requires-body=1,max-size=-1,engine=webview,script-path=https://raw.githubusercontent.com/kokoryh/Sparkle/refs/heads/master/dist/webpage.bilibili.js

# 注意：pattern 已去掉 ViewProgress，避免覆盖 airborne 注入的章节
bilibili.protobuf.response = type=http-response,pattern=^https:\/\/(?:grpc\.biliapi\.net|app\.bilibili\.com)(?::443)?\/bilibili\.(?:app\.(?:show\.v1\.Popular\/Index|dynamic\.v2\.Dynamic\/DynAll|view(?:unite)?\.v1\.View\/(?:View|RelatesFeed|AIRelateAsync)|playurl\.v1\.PlayURL\/PlayView|playerunite\.v1\.Player\/PlayViewUnite)|polymer\.app\.search\.v1\.Search\/SearchAll|community\.service\.dm\.v1\.DM\/DmView|main\.community\.reply\.v1\.Reply\/MainList|pgc\.gateway\.player\.v2\.PlayURL\/PlayView)$,argument="{"displayUpList":"auto","purifyComment":1,"sponsorBlock":true,"logLevel":"4"}",requires-body=1,binary-body-mode=1,max-size=-1,engine=webview,timeout=10,script-path=https://raw.githubusercontent.com/kokoryh/Sparkle/refs/heads/master/dist/bilibili.protobuf.response.js

[MITM]
h2 = true
hostname = %APPEND% grpc.biliapi.net, app.bilibili.com, api.bilibili.com, api.live.bilibili.com, www.bilibili.com, line3-h5-mobile-api.biligame.com, upos-sz-static.bilivideo.com, cm.bilibili.com
